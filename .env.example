# ─── AI (required for real results) ──────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# Models — change here, no code changes needed.
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high | xhigh | max | auto
OPENAI_IMAGE_QUALITY=high
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Image models in the picker, in order. The first one with a key is the default.
IMAGE_PROVIDERS=gemini,openai

# 1 = fake AI responses (no keys, no cost). Good for UI work.
MOCK_AI=0

# ─── Database: Neon Postgres (Vercel Marketplace adds this) ──────
# Leave empty locally to use an in-process Postgres stored in .data/
DATABASE_URL=

# ─── Storage ─────────────────────────────────────────────────────
# Option A (used when S3_BUCKET is set): Neon storage / any S3-compatible bucket.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=
# Option B: Vercel Blob.
BLOB_READ_WRITE_TOKEN=
# Neither set → local files in .data/files

# ─── Rate limiting: Upstash Redis (optional locally) ─────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_LISTING_LIMIT=20
DAILY_IMAGE_LIMIT=150
